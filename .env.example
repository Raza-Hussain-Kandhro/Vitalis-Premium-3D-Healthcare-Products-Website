# ---------------------------------------------------------------
# FRONTEND (Vite exposes only VITE_* vars to the browser bundle)
# ---------------------------------------------------------------
# Same-origin on Vercel, so "/api" is correct in production.
VITE_API_URL=/api

# ---------------------------------------------------------------
# BACKEND (server-only — never prefixed with VITE_)
# ---------------------------------------------------------------
# Pooled Postgres connection string (Neon pooler / Supabase pgbouncer :6543).
# Neon example:     postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/vitalis?sslmode=require
# Supabase example: postgres://postgres.<ref>:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct (non-pooled) connection — used ONLY by drizzle-kit migrations locally.
DATABASE_URL_UNPOOLED=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS: comma-separated list of allowed origins. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Optional: media uploads go to external object storage (never the FS)
BLOB_READ_WRITE_TOKEN=
